---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListingCard from '../../components/ListingCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const listings = await getCollection('listings');
  const categories = [...new Set(listings.map((l) => l.data.category))];
  
  return categories.map((cat) => ({
    params: { category: cat.toLowerCase().replace(/\s+/g, '-') },
    props: {
      category: cat,
      listings: listings.filter((l) => l.data.category === cat),
    },
  }));
}

const { category, listings } = Astro.props;
const currentYear = new Date().getFullYear();

const title = `Best ${category} Anime to Watch in ${currentYear} | Top Rated & Popular`;
const description = `Discover the best ${category} anime series and movies. Browse top-rated ${category} titles, read reviews, and find where to stream them. updated for ${currentYear}.`;
---
export const prerender = true;


<BaseLayout title={title} description={description}>
  <div class="mb-4">
    <a href="/" class="text-blue-600 hover:underline">Home</a> &rsaquo; <span class="text-gray-500">{category} Anime</span>
  </div>

  <h1 class="text-3xl md:text-4xl font-bold mb-4">Best {category} Anime</h1>
  <p class="text-lg text-gray-700 mb-8">
    Explore our curated list of the best <strong>{category}</strong> anime. Whether you're looking for classic masterpieces or the latest hits, find the perfect series to watch next.
    Showing {listings.length} titles.
  </p>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {listings.map((listing: any) => (
      <ListingCard {...listing.data} />
    ))}
  </div>
  
  <div class="mt-12 p-6 bg-gray-50 rounded-lg border border-gray-200">
    <h2 class="text-xl font-bold mb-3">About {category} Anime</h2>
    <p class="text-gray-600">
      Looking for more recommendations? Check out our <a href="/blog/anime-genres-explained" class="text-blue-600 hover:underline">Genre Guide</a> to understand what makes {category} anime unique.
    </p>
  </div>
</BaseLayout>
